# ElevenLabs API key — required for voice generation.
# Copy this file to .env and fill in the value. NEVER commit .env.
ELEVENLABS_API_KEY=

# Port the server listens on. Railway sets PORT automatically.
PORT=3000

# Model used for speech generation.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: a default voice ID to use until a caregiver picks one.
# Leave empty to fall back to a stable default voice on first synthesis.
ELEVENLABS_VOICE_ID=

# Optional: caregiver alert channel. Values: none | log
# Kept to "log" by default so nothing is sent to a real phone without
# the caregiver explicitly configuring a provider.
ALERT_CHANNEL=log
